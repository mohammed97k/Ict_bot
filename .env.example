# ═══════════════════════════════════════
#  انسخ هذا الملف إلى .env وعبّئ قيمك
# ═══════════════════════════════════════

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── TwelveData ───
TWELVEDATA_API_KEY=your_twelvedata_key_here
TWELVEDATA_TICKER=NDX

# ─── KiT Hub API ───
KIT_API_KEY=your_kit_key_here
KIT_API_SECRET=your_kit_secret_here
KIT_BASE_URL=https://api.kithub.com
KIT_SYMBOL=NAS100

# ─── Strategy ───
TIMEFRAME=5min
LOOKBACK_DAYS=30
